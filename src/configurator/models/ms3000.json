    { "when": { "solenoid": ["4B", "4E"] }, "forbid": { "operation": ["PA", "PB"] },
      "reason": "these solenoids cover UT-0 to UT-5, per their printed span" },
    { "when": { "limitSwitch": ["A", "C"] }, "forbid": { "operation": ["HL", "NN", "P7", "P8", "PF", "P9", "PA", "PB", "S6", "S7", "SF", "S8", "S9", "M2", "M3", "M4", "M5", "M7", "M8", "M9", "MC"] },
      "reason": "these limit switches mount to UT-0 through UT-3 actuators, per their printed range" },
    { "when": { "limitSwitch": ["B", "D"] }, "forbid": { "operation": ["HL", "NN", "P2", "P3", "P4", "P5", "P6", "S1", "S2", "S3", "S4", "S5", "M2", "M3", "M4", "M5", "M7", "M8", "M9", "MC"] },
      "reason": "these limit switches mount to UT-3.5 through UT-7 actuators, per their printed range" },
    { "when": { "positioner": ["A", "C", "E", "Q"] }, "forbid": { "operation": ["HL", "NN", "P7", "P8", "PF", "P9", "PA", "PB", "S6", "S7", "SF", "S8", "S9", "M2", "M3", "M4", "M5", "M7", "M8", "M9", "MC"] },
      "reason": "these positioners are for UT-0 through UT-3 actuators, per their printed range" },
    { "when": { "positioner": ["B", "D", "F", "R"] }, "forbid": { "operation": ["HL", "NN", "P2", "P3", "P4", "P5", "P6", "S1", "S2", "S3", "S4", "S5", "M2", "M3", "M4", "M5", "M7", "M8", "M9", "MC"] },
      "reason": "these positioners are for UT-3.5 through UT-7 actuators, per their printed range" },
    { "when": { "positioner": ["E", "F"] }, "forbid": { "operation": ["S1", "S2", "S3", "S4", "S5", "S6", "S7", "SF", "S8", "S9"] },
      "reason": "the 2-IQ DA positioners pair with double acting actuators, as printed" },
    { "when": { "positioner": ["Q"] }, "forbid": { "operation": ["P2", "P3", "P4", "P5", "P6", "P7", "P8", "PF", "P9", "PA", "PB"] },
      "reason": "the 2-IQ SR positioner pairs with spring return actuators, as printed; R's own label prints DA and is left unasserted" },
    { "when": { "fail": ["1", "2", "3", "4"] }, "forbid": { "operation": ["HL", "NN", "P2", "P3", "P4", "P5", "P6", "P7", "P8", "PF", "P9", "PA", "PB", "M2", "M3", "M4", "M5", "M7", "M8", "M9", "MC"] },
      "reason": "a fail position is the spring's doing; it belongs to spring return builds" },
    { "when": { "accessory": "04" }, "forbid": { "operation": ["HL", "NN", "M2", "M3", "M4", "M5", "M7", "M8", "M9", "MC"] },
      "reason": "an air filter regulator serves a pneumatic actuator" }
  ],
  "cautions": [
    { "when": { "size": ["025", "038", "125", "300"] },
      "note": "The sheet's own asterisk: this size is consult factory." },
    { "when": { "operation": ["M2", "M3", "M4", "M5", "M7", "M8", "M9", "MC"] },
      "note": "The electric actuators in this matrix are Nema 4. A Nema 7 electric build has no designator here and is quoted per enquiry, per James, July 2026." },
    { "when": { "positioner": "R" },
      "note": "The R positioner's printed label says DA where the pattern says SR; confirm with the factory before relying on it." }
  ]

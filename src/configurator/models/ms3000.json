    { "when": { "solenoid": ["4B", "4E"] }, "forbid": { "operation": ["HL", "NN", "S1", "S2", "S3", "S4", "S5", "S6", "S7", "SF", "S8", "S9", "M2", "M3", "M4", "M5", "M7", "M8", "M9", "MC"] },

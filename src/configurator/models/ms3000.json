    { "when": { "solenoid": ["3A", "3C"] }, "forbid": { "operation": ["S9"] },
      "reason": "the 8551 solenoids cover UT-0 to UT-5, per their printed span" },
    { "when": { "solenoid": ["3J", "3Q"] }, "forbid": { "operation": ["S5", "S6", "S7", "SF", "S8", "S9"] },

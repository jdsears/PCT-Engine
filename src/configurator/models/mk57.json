  "constraints": [
    { "when": { "size": ["250", "300", "400", "600"] }, "forbid": { "ends": ["PT", "BT", "BP", "SW", "F5", "F3", "F1", "F2"] },
      "reason": "the threaded, socket weld and FE ends are printed for the 1/2 to 2 inch size range" },
    { "when": { "size": ["050", "075", "100", "125", "150", "200"] }, "forbid": { "ends": ["I5", "I3", "I1", "I2", "I7", "I6", "I8", "I4"] },
      "reason": "the IFE ends are printed for the 2-1/2 to 6 inch size range" },
    { "when": { "ends": ["I5", "I3"] }, "forbid": { "body": ["CI"] },
      "reason": "the 150# and 300# IFE ends are printed for carbon steel, stainless or ductile iron" },
    { "when": { "ends": ["I1", "I2"] }, "forbid": { "body": ["DI", "CS", "S6"] },
      "reason": "the 125# and 250# IFE ends are printed for cast iron" }
  ],
  "cautions": [
    { "when": { "ends": "BT" },

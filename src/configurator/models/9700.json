{
  "model": "9700",
  "line": "marwin",
  "displayName": "Marwin 9700 series seal welded ball valve",
  "match": ["9700", "9700f", "9700r", "marwin 9700", "seal welded"],
  "source": { "doc": "9700Series.pdf", "page": 3, "section": "Sample ordering schematic" },
  "note": "Extracted by hand from the ordering schematic. Letter sizes 02A to 15A on the full port and 20A alone on the reduced, held as constraints. Grafoil/Delrin is the only listed packing-seat and FNPT the only end. Carbon steel bodies carry the sheet's own special-order consult-factory line as a caution, which matches the price book listing the whole series consult factory. Pneumatics to UT-2.5 double acting and UT-3.5 spring, electrics M1 to M4 by way of M8, exactly as printed.",
  "assembly": "{model}-{size}-{body}/{packingSeat}{ends}{operation}{pressure}{solenoid}{limitSwitch}{fail}",
  "slots": [
    {
      "id": "model", "label": "Model and port", "position": 1, "required": true,
      "options": [
        { "code": "9700F", "label": "Full port, 1/4\" to 1-1/2\"", "aliases": ["full port", "9700f"] },
        { "code": "9700R", "label": "Reduced port, 2\"", "aliases": ["reduced port", "9700r"] }
      ]
    },
    {
      "id": "size", "label": "Size", "position": 2, "required": true,
      "options": [
        { "code": "02A", "label": "1/4\"", "aliases": ["1/4\""] },
        { "code": "03A", "label": "3/8\"", "aliases": ["3/8\""] },
        { "code": "05A", "label": "1/2\"", "aliases": ["1/2\""] },
        { "code": "07A", "label": "3/4\"", "aliases": ["3/4\""] },
        { "code": "10A", "label": "1\"", "aliases": ["1\""] },
        { "code": "12A", "label": "1-1/4\"", "aliases": ["1-1/4\""] },
        { "code": "15A", "label": "1-1/2\"", "aliases": ["1-1/2\""] },
        { "code": "20A", "label": "2\" (reduced port)", "aliases": ["2\""] }
      ]
    },
    {
      "id": "body", "label": "Body material", "position": 3, "required": true,
      "options": [
        { "code": "CS", "label": "Carbon steel (special order, consult factory)", "aliases": ["carbon steel"] },
        { "code": "S6", "label": "Stainless steel", "aliases": ["stainless", "316"] }
      ]
    },
    {
      "id": "packingSeat", "label": "Packing and seat (1)", "position": 4, "required": true,

      "options": [
        { "code": "00", "label": "None", "aliases": ["no limit switch"] },
        { "code": "AA", "label": "LS FMYB-5120-N4, fits UT-0 to UT-3", "aliases": ["fmyb n4 small"] },
        { "code": "AB", "label": "LS FMYB-5120-N4, fits UT-3.5 to UT-7", "aliases": ["fmyb n4 large"] },
        { "code": "AC", "label": "LS AMYB-5120-N7, fits UT-0 to UT-3", "aliases": ["amyb n7 small"] },
        { "code": "AD", "label": "LS AMYB-5120-N7, fits UT-3.5 to UT-7", "aliases": ["amyb n7 large"] },
        { "code": "ZZ", "label": "Non-standard limit switch", "aliases": ["non-standard limit switch"] }
      ]
    },
    {
      "id": "fail", "label": "Fail position (11 and 12)", "position": 10, "required": true,
      "options": [
        { "code": "NN", "label": "Fail position N/A (no spring return actuator)", "aliases": ["no fail action", "n/a"] },
        { "code": "01", "label": "Fail closed", "aliases": ["fail closed"] },
        { "code": "02", "label": "Fail open", "aliases": ["fail open"] }
      ]
    }
  ],
  "constraints": [
    { "when": { "operation": ["HL", "NN", "M1", "M2", "M3", "M4", "M5", "M8"] }, "forbid": { "pressure": ["60", "80"] },
      "reason": "an air supply pressure applies only to a pneumatic actuator" },
    { "when": { "operation": ["P1", "P2", "P3", "P4", "P5", "P6", "S1", "S2", "S3", "S4", "S5", "S6", "S7"] }, "forbid": { "pressure": ["NN"] },
      "reason": "a pneumatic actuator needs its air supply stated" },
    { "when": { "solenoid": ["3A", "3C", "3J", "3M", "3Q", "3R"] }, "forbid": { "operation": ["HL", "NN", "P1", "P2", "P3", "P4", "P5", "P6", "M1", "M2", "M3", "M4", "M5", "M8"] },
      "reason": "a three-way solenoid pairs with a spring return actuator, as its own table marks" },
    { "when": { "solenoid": ["4A", "4B", "4D", "4E"] }, "forbid": { "operation": ["HL", "NN", "S1", "S2", "S3", "S4", "S5", "S6", "S7", "M1", "M2", "M3", "M4", "M5", "M8"] },
      "reason": "a four-way solenoid pairs with a double acting actuator, as its own table marks" },
    { "when": { "solenoid": ["3J", "3Q"] }, "forbid": { "operation": ["S5", "S6", "S7"] },
      "reason": "the 8317 solenoids cover UT-0 to UT-2.5, per their printed span" },
    { "when": { "solenoid": ["3M", "3R"] }, "forbid": { "operation": ["S1", "S2", "S3", "S4"] },
      "reason": "the 8321 solenoids cover UT-3 to UT-5, per their printed span" },
    { "when": { "solenoid": ["4A", "4D"] }, "forbid": { "operation": ["P2", "P3", "P4", "P5", "P6"] },
      "reason": "these solenoids are marked for the UT-0A actuator alone" },
    { "when": { "limitSwitch": ["AA", "AC"] }, "forbid": { "operation": ["HL", "NN", "S6", "S7", "M1", "M2", "M3", "M4", "M5", "M8"] },
      "reason": "these limit switches mount to UT-0 through UT-3 actuators, per their printed range" },
    { "when": { "limitSwitch": ["AB", "AD"] }, "forbid": { "operation": ["HL", "NN", "P1", "P2", "P3", "P4", "P5", "P6", "S1", "S2", "S3", "S4", "S5", "M1", "M2", "M3", "M4", "M5", "M8"] },
      "reason": "these limit switches mount to UT-3.5 through UT-7 actuators, per their printed range" },
    { "when": { "fail": ["01", "02"] }, "forbid": { "operation": ["HL", "NN", "P1", "P2", "P3", "P4", "P5", "P6", "M1", "M2", "M3", "M4", "M5", "M8"] },
      "reason": "a fail position is the spring's doing; it belongs to spring return builds" }
  ],
  "cautions": [
    { "when": { "operation": ["M1", "M2", "M3", "M4", "M5", "M8"] },
      "note": "The electric actuators in this matrix are Nema 4. A Nema 7 electric build has no designator here and is quoted per enquiry, per James, July 2026." }
  ]
}

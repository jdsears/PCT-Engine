      "options": [
        { "code": "00", "label": "None", "aliases": ["no limit switch"] },
        { "code": "AA", "label": "LS FMYB-5120-N4, to UT-0/3", "aliases": ["fmyb n4 small"] },
        { "code": "AB", "label": "LS FMYB-5120-N4, to UT-3.5/7", "aliases": ["fmyb n4 large"] },
        { "code": "AC", "label": "LS AMYB-5120-N7, to UT-0/3", "aliases": ["amyb n7 small"] },
        { "code": "AD", "label": "LS AMYB-5120-N7, to UT-3.5/7", "aliases": ["amyb n7 large"] },
        { "code": "AE", "label": "LS AMYB-5120-N4, to valve", "aliases": ["amyb n4 valve"] },

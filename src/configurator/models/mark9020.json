  ],
  "constraints": [
    { "when": { "pedCe": "CE" }, "forbid": { "size": ["050", "075", "100"] },
      "reason": "the CE mark carries the sheet's own 1.5 to 4 inch bracket" },
    { "when": { "ends": "2" }, "forbid": { "size": ["150", "200", "250", "300", "400"] },
      "reason": "the comp tube fitting ends are printed for 1/2 to 1 inch valves alone" },
    { "when": { "operation": ["HL", "NN"] }, "forbid": { "actuatorPressure": ["40", "60", "80"] },
      "reason": "an air supply pressure applies only to a pneumatic actuator" },
    { "when": { "operation": ["P1", "P2", "P3", "P4", "P5", "P6", "P7", "P8", "PF", "P9", "S1", "S2", "S3", "S4", "S5", "S6", "S7", "SF", "S8"] }, "forbid": { "actuatorPressure": ["NN"] },
      "reason": "a pneumatic actuator needs its air supply stated" },
    { "when": { "solenoid": ["3A", "3C", "3J", "3M", "3Q", "3R"] }, "forbid": { "operation": ["HL", "NN", "P1", "P2", "P3", "P4", "P5", "P6", "P7", "P8", "PF", "P9"] },
      "reason": "a three-way solenoid pairs with a spring return actuator, as its own column marks" },
    { "when": { "solenoid": ["4A", "4B", "4D", "4E"] }, "forbid": { "operation": ["HL", "NN", "S1", "S2", "S3", "S4", "S5", "S6", "S7", "SF", "S8"] },
      "reason": "a four-way solenoid pairs with a double acting actuator, as its own column marks" },
    { "when": { "solenoid": ["3J", "3Q"] }, "forbid": { "operation": ["S5", "S6", "S7", "SF", "S8"] },
      "reason": "the 8317 solenoids cover UT-0 to UT-2.5, per their printed span" },
    { "when": { "solenoid": ["3M", "3R"] }, "forbid": { "operation": ["S1", "S2", "S3", "S4"] },
      "reason": "the 8321 solenoids cover UT-3 to UT-5, per their printed span" },
    { "when": { "solenoid": ["4A", "4D"] }, "forbid": { "operation": ["P2", "P3", "P4", "P5", "P6", "P7", "P8", "PF", "P9"] },
      "reason": "these solenoids are marked for the UT-0A actuator alone" },
    { "when": { "limitSwitch": ["AA", "AC"] }, "forbid": { "operation": ["HL", "NN", "P7", "P8", "PF", "P9", "S6", "S7", "SF", "S8"] },
      "reason": "these limit switches mount to UT-0 through UT-3 actuators, per their printed span" },
    { "when": { "limitSwitch": ["AB", "AD"] }, "forbid": { "operation": ["HL", "NN", "P1", "P2", "P3", "P4", "P5", "P6", "S1", "S2", "S3", "S4", "S5"] },
      "reason": "these limit switches mount to UT-3.5 through UT-7 actuators, per their printed span" },
    { "when": { "fail": ["01", "02"] }, "forbid": { "operation": ["HL", "NN", "P1", "P2", "P3", "P4", "P5", "P6", "P7", "P8", "PF", "P9"] },
      "reason": "a fail position is the spring's doing; it belongs to spring return builds" },
    { "when": { "positioner": ["AA", "AC"] }, "forbid": { "operation": ["HL", "NN", "P7", "P8", "PF", "P9", "S6", "S7", "SF", "S8"] },
      "reason": "these positioners are printed for UT-0 through UT-3" },
    { "when": { "positioner": ["AB", "AD"] }, "forbid": { "operation": ["HL", "NN", "P1", "P2", "P3", "P4", "P5", "P6", "S1", "S2", "S3", "S4", "S5"] },
      "reason": "these positioners are printed for UT-3.5 through UT-7" },
    { "when": { "positioner": ["AE", "AQ"] }, "forbid": { "operation": ["HL", "NN", "P7", "P8", "PF", "P9", "S6", "S7", "SF", "S8"] },
      "reason": "these positioners are printed for UT-0 through UT-3" },
    { "when": { "positioner": ["AF", "AR"] }, "forbid": { "operation": ["HL", "NN", "P1", "P2", "P3", "P4", "P5", "P6", "S1", "S2", "S3", "S4", "S5"] },
      "reason": "these positioners are printed for UT-3.5 through UT-7" },
    { "when": { "positioner": ["AE", "AF"] }, "forbid": { "operation": ["S1", "S2", "S3", "S4", "S5", "S6", "S7", "SF", "S8"] },
      "reason": "these positioner rows are marked DA" },
    { "when": { "positioner": ["AQ", "AR"] }, "forbid": { "operation": ["P1", "P2", "P3", "P4", "P5", "P6", "P7", "P8", "PF", "P9"] },
      "reason": "these positioner rows are marked SR" },
    { "when": { "misc": "4" }, "forbid": { "operation": ["P6", "P7", "P8", "PF", "P9", "S5", "S6", "S7", "SF", "S8"] },
      "reason": "the AFR row is printed to UT-0 through UT-2.5" },
    { "when": { "sep": ["G", "H"] }, "forbid": { "size": ["150", "200", "250", "300", "400"] },
      "reason": "the SEP options are printed 0.5 to 1 inch only" }
  ],
  "cautions": []
}

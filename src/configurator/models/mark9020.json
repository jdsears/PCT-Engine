{
  "model": "9020",
  "line": "steriflow",
  "displayName": "Steriflow Mark 9020 3-piece BPE sanitary ball valve",
  "match": ["9020", "mark 9020", "mk9020", "sanitary ball valve"],
  "source": { "doc": "mark9020.pdf", "page": "15 and 16", "section": "Ordering schematic" },
  "note": "Extracted by hand from the ordering schematic, the Marwin UT actuator family in sanitary form. The PED/CE segment is blank on a standard valve and CE on the marked form, the empty-code device, with the CE mark held to the sheet's own 1.5 to 4 inch bracket. One decode limit is confessed rather than papered over: a standard build whose seat prints C and ends print E opens with the same letters as the CE marked form, so the engine assembles such a code correctly but cannot read it back unambiguously. The solenoid, limit switch, positioner and miscellaneous feature couplings follow each row's own printed UT spans and actuator classes, and the SEP options keep their half to one inch bracket.",
  "assembly": "{model}-{size}-{bodyMat}-{pedCe}{seat}{ends}{operation}{actuatorPressure}{solenoid}{limitSwitch}{fail}{positioner}{misc}{sep}",
  "slots": [
    {
      "id": "model", "label": "Model", "position": 1, "required": true,
      "options": [ { "code": "9020", "label": "3-piece BPE sanitary ball valve", "aliases": ["9020", "sanitary ball"] } ]
    },
    {
      "id": "size", "label": "Size", "position": 2, "required": true,
      "options": [

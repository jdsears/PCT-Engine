        { "code": "AF", "label": "Siemens 2-IQ (4-20 mA), for UT-3.5/7 DA", "aliases": ["2-iq large da"] },
        { "code": "AQ", "label": "Siemens 2-IQ (4-20 mA), for UT-0/3 SR", "aliases": ["2-iq small sr"] },

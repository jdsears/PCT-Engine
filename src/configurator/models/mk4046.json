  "constraints": [
    { "when": { "model": "46" }, "forbid": { "floatArm": ["CS", "S6", "BR"], "float": ["6C", "6S", "8C", "8S", "2C", "2S"] },
      "reason": "the lever operated 46 takes the 00 none codes in the float arm and float positions, per its own rows" },
    { "when": { "model": "40" }, "forbid": { "floatArm": ["00"], "float": ["00"] },
      "reason": "the float operated 40 chooses a real arm and float, per its own rows" },
    { "when": { "lever": ["15", "24"] }, "forbid": { "size": ["250", "300", "400", "600"] },
      "reason": "the 15 and 24 inch levers are printed for 1/4 to 2 inch" },
    { "when": { "lever": ["26", "42"] }, "forbid": { "size": ["025", "038", "050", "075", "100", "125", "150", "200"] },
      "reason": "the 26 and 42 inch levers are printed for 2-1/2 to 6 inch" },
    { "when": { "float": ["6C", "6S"] }, "forbid": { "size": ["100", "125", "150", "200", "250", "300", "400", "600"] },
      "reason": "the 6 inch floats are printed for 1/4 to 3/4 inch" },
    { "when": { "float": ["8C", "8S"] }, "forbid": { "size": ["025", "038", "050", "075", "250", "300", "400", "600"] },
      "reason": "the 8 inch floats are printed for 1 to 2 inch" },
    { "when": { "float": ["2C", "2S"] }, "forbid": { "size": ["025", "038", "050", "075", "100", "125", "150", "200"] },
      "reason": "the 12 inch floats are printed for 2-1/2 to 6 inch" }

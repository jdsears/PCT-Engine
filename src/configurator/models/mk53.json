{
  "model": "MK53",
  "line": "jordan",
  "displayName": "Jordan Mark 53/54 differential back pressure regulator",
  "match": ["mk53", "mark 53", "mk54", "mark 54", "jordan 53", "jordan 54"],
  "source": { "doc": "mk53_54.pdf", "page": 4, "section": "Ordering Schematic" },
  "note": "Extracted by hand from the ordering schematic, the back pressure mirror of the 63/64. The options position prints single letters with no none row, so an empty code carries the plain build. The spring tables run per model, option and size band, with the 14 and 34 ranges shared between the small MK53 and the MK54 and the high pressure ranges tied to the HP option; the HP table's first code prints A3 where the 63 sheet prints A1 for the same span, carried as printed. Held for the PDF: the F5 and F3 ends print IFE against the F family's FE, carried with the family constraint and this note. The diaphragm position prints four character codes pairing the material with its actuator.",
  "assembly": "{model}{options}{size}{body}/{ends}{trim}{seat}{cv}{spring}{diaphragmActuator}",
  "slots": [
    {
      "id": "model", "label": "Model", "position": 1, "required": true,
      "options": [
        { "code": "53", "label": "Standard", "aliases": ["mk53", "standard"] },
        { "code": "54", "label": "Large diaphragm", "aliases": ["mk54", "large diaphragm"] }
      ]
    },
    {
      "id": "options", "label": "Options", "position": 2, "required": true,
      "options": [
        { "code": "", "label": "None (plain build)", "aliases": ["none", "no options", "plain"] },
        { "code": "C", "label": "Closing cap", "aliases": ["closing cap"] },
        { "code": "D", "label": "Separated double diaphragm", "aliases": ["double diaphragm"] },
        { "code": "F", "label": "Flow through dome", "aliases": ["flow through dome"] },
        { "code": "H", "label": "Handwheel", "aliases": ["handwheel"] },
        { "code": "HP", "label": "High pressure", "aliases": ["high pressure"] }
      ]
    },
    {
      "id": "size", "label": "Size", "position": 3, "required": true,
      "options": [
        { "code": "025", "label": "1/4\" (DN8)", "aliases": ["1/4\"", "DN8"] },
        { "code": "038", "label": "3/8\" (DN12)", "aliases": ["3/8\""] },
        { "code": "050", "label": "1/2\" (DN15)", "aliases": ["1/2\"", "DN15"] },
        { "code": "075", "label": "3/4\" (DN20)", "aliases": ["3/4\"", "DN20"] },
        { "code": "100", "label": "1\" (DN25)", "aliases": ["1\"", "DN25"] },

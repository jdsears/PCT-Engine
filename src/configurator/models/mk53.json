        { "code": "6", "label": "4.4 (3.78 Kv)", "aliases": ["4.4"] },
        { "code": "7", "label": "6.4 (5.50 Kv)", "aliases": ["6.4"] },
        { "code": "8", "label": "9.5 (8.17 Kv)", "aliases": ["9.5"] },
        { "code": "9", "label": "15 (12.9 Kv)", "aliases": ["15"] },

        { "code": "06", "label": "2-6 psi, MK53 1\" to 2\"", "aliases": ["2-6"] },
        { "code": "21", "label": "4-13 psi, MK53 1\" to 2\"", "aliases": ["4-13"] },
        { "code": "31", "label": "8-20 psi, MK53 1\" to 2\"", "aliases": ["8-20"] },
        { "code": "50", "label": "15-80 psi, MK53 1\" to 2\"", "aliases": ["15-80"] },
        { "code": "95", "label": "45-150 psi, MK53 1\" to 2\"", "aliases": ["45-150"] },
        { "code": "A3", "label": "75-190 psi, MK53HP 1/2\" to 2\" (the 63 sheet prints A1 for this span)", "aliases": ["75-190"] },
        { "code": "A7", "label": "100-320 psi, MK53HP 1/2\" to 2\"", "aliases": ["100-320"] },
        { "code": "A9", "label": "150-450 psi, MK53HP 1/2\" to 2\"", "aliases": ["150-450"] },
        { "code": "04", "label": "1/2-5 psi, MK54", "aliases": ["0.5-5"] },
        { "code": "08", "label": "2-10 psi, MK54", "aliases": ["2-10"] },
        { "code": "54", "label": "20-50 psi, MK54", "aliases": ["20-50"] },
        { "code": "62", "label": "20-70 psi, MK54", "aliases": ["20-70"] },
        { "code": "86", "label": "40-105 psi, MK54", "aliases": ["40-105"] },
        { "code": "69", "label": "25-150 psi, MK54", "aliases": ["25-150"] },
        { "code": "79", "label": "30-170 psi, MK54", "aliases": ["30-170"] }
      ]
    },
    {
      "id": "diaphragmActuator", "label": "Diaphragm", "position": 10, "required": true,
      "options": [
        { "code": "S6MD", "label": "316SST, metal diaphragm actuator", "aliases": ["316 diaphragm"] },
        { "code": "VIED", "label": "Viton, elastomer actuator", "aliases": ["viton diaphragm"] },

  "constraints": [
    { "when": { "ends": ["I5", "I3"] }, "forbid": { "body": ["DI", "BR"] },
      "reason": "the 150# and 300# IFE rows are printed for carbon or stainless valves" },
    { "when": { "ends": ["F5", "F3"] }, "forbid": { "body": ["CS", "S6"] },
      "reason": "these rows are printed for ductile iron or bronze" },
    { "when": { "trim": ["I3", "I6"] }, "forbid": { "size": ["025", "038"] },
      "reason": "the F/IFE trims are printed 1/2 to 2 inch" },
    { "when": { "spring": ["53", "76", "A4"] }, "forbid": { "model": ["54"] },
      "reason": "these ranges are printed in the MK53 table" },
    { "when": { "spring": ["53", "76", "A4"] }, "forbid": { "size": ["100", "125", "150", "200"] },
      "reason": "these ranges are printed for 1/4 to 3/4 inch" },
    { "when": { "spring": ["14", "34"], "model": "53" }, "forbid": { "size": ["100", "125", "150", "200"] },
      "reason": "on the MK53 these ranges are printed for 1/4 to 3/4 inch" },
    { "when": { "spring": ["03", "06", "21", "31", "50", "95"] }, "forbid": { "model": ["54"] },
      "reason": "these ranges are printed in the MK53 table" },
    { "when": { "spring": ["03", "06", "21", "31", "50", "95"] }, "forbid": { "size": ["025", "038", "050", "075"] },
      "reason": "these ranges are printed for 1 to 2 inch" },
    { "when": { "spring": ["A3", "A7", "A9"] }, "forbid": { "model": ["54"], "options": ["", "C", "D", "F", "H"] },
      "reason": "these ranges are printed in the MK53HP table, so the high pressure option is the build they belong to" },
    { "when": { "spring": ["A3", "A7", "A9"] }, "forbid": { "size": ["025", "038"] },
      "reason": "the high pressure ranges are printed for 1/2 to 2 inch" },
    { "when": { "options": "HP" }, "forbid": { "spring": ["14", "34", "53", "76", "A4", "03", "06", "21", "31", "50", "95", "04", "08", "54", "62", "86", "69", "79"] },
      "reason": "the high pressure option takes the MK53HP table alone" },
    { "when": { "spring": ["04", "08", "54", "62", "86", "69", "79"] }, "forbid": { "model": ["53"] },
      "reason": "these ranges are printed in the MK54 table" }
  ],
  "cautions": []
}

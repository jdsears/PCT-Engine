      "reason": "these ranges are printed for 2-1/2 to 4 inch" },
    { "when": { "spring": ["A1", "A7", "A9"] }, "forbid": { "model": ["50", "50QC", "51"] },
      "reason": "these ranges are printed in the MK50HP table" },
    { "when": { "spring": ["A1", "A7", "A9"] }, "forbid": { "size": ["025", "038", "250", "300", "400"] },
      "reason": "these high pressure ranges are printed for 1/2 to 2 inch" },
    { "when": { "spring": ["64", "82"] }, "forbid": { "model": ["50", "50QC", "51"] },
      "reason": "these ranges are printed in the MK50HP table" },
    { "when": { "spring": ["64", "82"] }, "forbid": { "size": ["025", "038", "050", "075", "100", "150", "200"] },
      "reason": "these ranges are printed for 2-1/2 to 4 inch" },
    { "when": { "spring": ["04", "08", "54", "62", "86", "69", "79"] }, "forbid": { "model": ["50", "50QC", "50HP"] },
      "reason": "these ranges are printed in the MK51 table" },
    { "when": { "spring": "04" }, "forbid": { "diaphragm": ["S6"] },
      "reason": "the sheet's asterisk on the 1/2-5 range: must use elastomer diaphragm (Jorlon's class is not stated, so it stays allowed, held for John)" },
    { "when": { "size": ["250", "300", "400"] }, "forbid": { "diaphragm": ["S6"] },
      "reason": "the 316 diaphragm is printed 1/4 to 2 inch only" },
    { "when": { "size": ["250", "300", "400"] }, "forbid": { "actuator": ["MD"] },
      "reason": "the metal diaphragm actuator is printed 1/4 to 2 inch only" }

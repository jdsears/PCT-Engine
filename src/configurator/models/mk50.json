  "constraints": [
    { "when": { "model": "51" }, "forbid": { "size": ["100", "150", "200", "250", "300", "400"] },
      "reason": "MK51 is available in 1/4 through 3/4 inch only, per the sheet's own line" },
    { "when": { "model": "50QC" }, "forbid": { "size": ["250", "300", "400"] },
      "reason": "the 2-1/2 to 4 inch rows are marked MK50 and MK50HP only" },
    { "when": { "body": "BR" }, "forbid": { "size": ["250", "300", "400"] },
      "reason": "bronze is printed 1/4 to 2 inch" },
    { "when": { "body": "CI" }, "forbid": { "size": ["025", "038", "050", "075", "100", "150", "200"] },
      "reason": "cast iron is printed 2-1/2 to 4 inch" },
    { "when": { "size": ["250", "300", "400"] }, "forbid": { "ends": ["PT", "BT", "BP", "SW", "F1", "F5", "F2", "F3"] },
      "reason": "the threaded, socket weld and FE ends belong to the 1/4 to 2 inch list; the 2-1/2 to 4 inch list is IFE only" },
    { "when": { "size": ["025", "038", "050", "075", "100", "150", "200"] }, "forbid": { "ends": ["I1", "I2"] },
      "reason": "the 125# and 250# IFE codes are printed in the 2-1/2 to 4 inch list only" },
    { "when": { "body": ["DI", "BR", "CI"] }, "forbid": { "ends": ["I7", "I6", "I8", "I4"] },
      "reason": "the DIN ends are printed for carbon and stainless bodies alone" },
    { "when": { "trim": ["I3", "I6"] }, "forbid": { "size": ["025", "038", "050", "075", "250", "300", "400"] },
      "reason": "the F/IFE trims are printed 1 to 2 inch" },
    { "when": { "size": ["250", "300", "400"] }, "forbid": { "seat": ["A", "B"] },
      "reason": "the plain SST seats are printed 1/4 to 2 inch" },
    { "when": { "size": "025" }, "forbid": { "cv": ["4", "5", "6", "7", "8", "9", "A", "B", "D", "F", "G", "I"] },
      "reason": "the Cv table tops the 1/4 inch at 0.84; the low flow note allows a smaller Cv in a larger valve, never the reverse" },
    { "when": { "size": "038" }, "forbid": { "cv": ["5", "6", "7", "8", "9", "A", "B", "D", "F", "G", "I"] },
      "reason": "the Cv table tops the 3/8 inch at 1.6" },
    { "when": { "size": ["050", "075"] }, "forbid": { "cv": ["7", "8", "9", "A", "B", "D", "F", "G", "I"] },
      "reason": "the Cv table tops the 1/2 and 3/4 inch at 4.4" },
    { "when": { "size": "100" }, "forbid": { "cv": ["9", "A", "B", "D", "F", "G", "I"] },
      "reason": "the Cv table tops the 1 inch at 9.5" },
    { "when": { "size": "150" }, "forbid": { "cv": ["A", "B", "D", "F", "G", "I"] },
      "reason": "the Cv table tops the 1-1/2 inch at 15" },
    { "when": { "size": "200" }, "forbid": { "cv": ["D", "F", "G", "I"] },
      "reason": "the Cv table tops the 2 inch at 30, and the starred Cvs are 2-1/2 to 4 inch only" },
    { "when": { "size": "250" }, "forbid": { "cv": ["F", "G", "I"] },
      "reason": "the Cv table tops the 2-1/2 inch at 55" },
    { "when": { "size": "300" }, "forbid": { "cv": ["I"] },
      "reason": "the Cv table tops the 3 inch at 115" },
    { "when": { "spring": ["53", "76", "A4"] }, "forbid": { "model": ["50HP", "51"] },
      "reason": "these ranges are printed in the MK50/50QC table" },
    { "when": { "spring": ["53", "76", "A4"] }, "forbid": { "size": ["100", "150", "200", "250", "300", "400"] },
      "reason": "these ranges are printed for 1/4 to 3/4 inch" },
    { "when": { "spring": ["14", "34"] }, "forbid": { "model": ["50HP"] },
      "reason": "these ranges are printed in the MK50/50QC and MK51 tables, not the high pressure one" },
    { "when": { "spring": ["14", "34"], "model": ["50", "50QC"] }, "forbid": { "size": ["100", "150", "200", "250", "300", "400"] },
      "reason": "on the MK50 and 50QC these ranges are printed for 1/4 to 3/4 inch" },
    { "when": { "spring": ["03", "06", "21", "31", "50", "95"] }, "forbid": { "model": ["50HP", "51"] },
      "reason": "these ranges are printed in the MK50/50QC table" },
    { "when": { "spring": ["03", "06", "21", "31", "50", "95"] }, "forbid": { "size": ["025", "038", "050", "075", "250", "300", "400"] },
      "reason": "these ranges are printed for 1 to 2 inch" },
    { "when": { "spring": ["22", "30", "52"] }, "forbid": { "model": ["50HP", "51"] },
      "reason": "these ranges are printed in the MK50/50QC table" },

  "constraints": [
    { "when": { "operation": ["HL", "NN", "M1", "M2", "M3", "M4", "M5", "M8", "M9", "MA"] }, "forbid": { "pressure": ["60", "80"] },
      "reason": "an air supply pressure applies only to a pneumatic actuator" },
    { "when": { "operation": ["P1", "P2", "P3", "P4", "P5", "P6", "P7", "P8", "S1", "S2", "S3", "S4", "S5", "S6", "S7", "SF", "S8", "S9"] }, "forbid": { "pressure": ["NN"] },
      "reason": "a pneumatic actuator needs its air supply stated" },
    { "when": { "solenoid": ["3A", "3C", "3J", "3M", "3Q", "3R"] }, "forbid": { "operation": ["HL", "NN", "P1", "P2", "P3", "P4", "P5", "P6", "P7", "P8", "M1", "M2", "M3", "M4", "M5", "M8", "M9", "MA"] },
      "reason": "a three-way solenoid pairs with a spring return actuator, as its own table marks" },
    { "when": { "solenoid": ["4A", "4B", "4D", "4E"] }, "forbid": { "operation": ["HL", "NN", "S1", "S2", "S3", "S4", "S5", "S6", "S7", "SF", "S8", "S9", "M1", "M2", "M3", "M4", "M5", "M8", "M9", "MA"] },
      "reason": "a four-way solenoid pairs with a double acting actuator, as its own table marks" },
    { "when": { "solenoid": ["3A", "3C"] }, "forbid": { "operation": ["S9"] },
      "reason": "the 8551 solenoids cover UT-0 to UT-5, per their printed span" },
    { "when": { "solenoid": ["3J", "3Q"] }, "forbid": { "operation": ["S5", "S6", "S7", "SF", "S8", "S9"] },
      "reason": "the 8317 solenoids cover UT-0 to UT-2.5, per their printed span" },
    { "when": { "solenoid": ["3M", "3R"] }, "forbid": { "operation": ["S1", "S2", "S3", "S4", "S9"] },
      "reason": "the 8321 solenoids cover UT-3 to UT-5, per their printed span" },
    { "when": { "solenoid": ["4A", "4D"] }, "forbid": { "operation": ["P2", "P3", "P4", "P5", "P6", "P7", "P8"] },
      "reason": "these solenoids are marked for the UT-0A actuator alone" },
    { "when": { "limitSwitch": ["AA", "AC"] }, "forbid": { "operation": ["HL", "NN", "P7", "P8", "S6", "S7", "SF", "S8", "S9", "M1", "M2", "M3", "M4", "M5", "M8", "M9", "MA"] },
      "reason": "these limit switches mount to UT-0 through UT-3 actuators, per their printed range" },
    { "when": { "limitSwitch": ["AB", "AD"] }, "forbid": { "operation": ["HL", "NN", "P1", "P2", "P3", "P4", "P5", "P6", "S1", "S2", "S3", "S4", "S5", "M1", "M2", "M3", "M4", "M5", "M8", "M9", "MA"] },
      "reason": "these limit switches mount to UT-3.5 through UT-7 actuators, per their printed range" },
    { "when": { "fail": ["01", "02"] }, "forbid": { "operation": ["HL", "NN", "P1", "P2", "P3", "P4", "P5", "P6", "P7", "P8", "M1", "M2", "M3", "M4", "M5", "M8", "M9", "MA"] },
      "reason": "a fail position is the spring's doing; it belongs to spring return builds" }
  ],
  "cautions": [
    { "when": { "operation": ["M1", "M2", "M3", "M4", "M5", "M8", "M9", "MA"] },

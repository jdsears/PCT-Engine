      "options": [
        { "code": "HL", "label": "Lever operated", "aliases": ["lever", "manual", "handle"] },
        { "code": "NN", "label": "None (bare valve)", "aliases": ["none", "bare", "no operator"] },
        { "code": "P1", "label": "UT-0A-DA STD actuator", "aliases": ["ut-0a da"] },
        { "code": "P2", "label": "UT-0-DA STD actuator", "aliases": ["ut-0 da"] },
        { "code": "P3", "label": "UT-1-DA STD actuator", "aliases": ["ut-1 da"] },

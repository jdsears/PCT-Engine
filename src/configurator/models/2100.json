{
  "model": "3T/3L-2100",
  "line": "marwin",
  "displayName": "Marwin 3T-2100 / 3L-2100 three-way ball valve",
  "match": ["2100", "3t-2100", "3l-2100", "3t2100", "3l2100", "three way", "3 way", "three-way", "multi port", "t port", "l port"],
  "source": { "doc": "3lt2100ff.pdf and 3lt2100fa.pdf", "page": 7, "section": "Ordering matrix, final page" },
  "note": "Extracted by hand from the ordering matrices on the final pages of the flanged (FF) and threaded (FA) sheets, which share every table except 1&2 end connections: BF/GF are the flanged pair, BA/GA the threaded pair. The code reads model, size, body material, then twelve character positions in six pairs, printed with hyphens and a slash exactly as the price book prints them. The threaded sheet's size table stops at 4 inch while the flanged sheet carries 6 inch, held as a constraint. The electric operation table lists Nema 4 actuators only; a Nema 7 electric build has no designator in this matrix, which is why the price book prints one code at two prices for those builds, so the Nema 7 electric is carried here as a caution and priced per enquiry, per James, July 2026. Solenoid and limit switch UT spans are enforced from the ranges printed in their own labels against the UT size named in the chosen operation code.",
  "assembly": "{model}-{size}-{body}/{ends}{operation}{pressure}{solenoid}{limitSwitch}{startPosition}",
  "slots": [
    {
      "id": "model", "label": "Model and port", "position": 1, "required": true,
      "options": [
        { "code": "3T-2100F", "label": "Three-way ball valve, T port", "aliases": ["t port", "t-port", "3t", "3t-2100", "3t2100"] },
        { "code": "3L-2100F", "label": "Three-way ball valve, L port", "aliases": ["l port", "l-port", "3l", "3l-2100", "3l2100"] }
      ]
    },
    {
      "id": "size", "label": "Size", "position": 2, "required": true,
      "options": [
        { "code": "050", "label": "1/2\"", "aliases": ["1/2\"", "half inch", "DN15"] },
        { "code": "075", "label": "3/4\"", "aliases": ["3/4\"", "DN20"] },
        { "code": "100", "label": "1\"", "aliases": ["1\"", "one inch", "DN25"] },
        { "code": "125", "label": "1-1/4\"", "aliases": ["1-1/4\"", "1 1/4\"", "DN32"] },
        { "code": "150", "label": "1-1/2\"", "aliases": ["1-1/2\"", "1 1/2\"", "DN40"] },
        { "code": "200", "label": "2\"", "aliases": ["2\"", "two inch", "DN50"] },
        { "code": "250", "label": "2-1/2\"", "aliases": ["2-1/2\"", "2 1/2\"", "DN65"] },
        { "code": "300", "label": "3\"", "aliases": ["3\"", "DN80"] },
        { "code": "400", "label": "4\"", "aliases": ["4\"", "DN100"] },
        { "code": "600", "label": "6\"", "aliases": ["6\"", "DN150"] }
      ]
    },
    {
      "id": "body", "label": "Body material", "position": 3, "required": true,
      "options": [
        { "code": "CS", "label": "Carbon steel", "aliases": ["carbon steel", "WCB"] },
        { "code": "S6", "label": "Stainless steel", "aliases": ["stainless", "stainless steel", "316", "SST"] }
      ]
    },
    {
      "id": "ends", "label": "Packing-seat and end connections (1 and 2)", "position": 4, "required": true,
      "options": [
        { "code": "BF", "label": "PTFE/RPTFE, 150# flange (standard, flanged)", "aliases": ["flanged", "150# flange", "ptfe flanged", "flange"] },
        { "code": "GF", "label": "Graphite/CRPTFE, 150# flange", "aliases": ["graphite flanged", "crptfe flange"] },
        { "code": "BA", "label": "PTFE/RPTFE, FNPT (standard, threaded)", "aliases": ["threaded", "npt", "fnpt", "ptfe threaded"] },
        { "code": "GA", "label": "Graphite/CRPTFE, FNPT", "aliases": ["graphite threaded", "crptfe npt"] }
      ]
    },
    {

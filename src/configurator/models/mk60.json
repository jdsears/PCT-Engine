  "constraints": [
    { "when": { "model": "61" }, "forbid": { "size": ["100", "125", "150", "200", "250", "300", "400"] },
      "reason": "MK61 is available in 1/4 through 3/4 inch only, per the sheet's own line" },
    { "when": { "model": "60QC" }, "forbid": { "size": ["250", "300", "400"] },
      "reason": "the 2-1/2 to 4 inch rows are marked MK60 and MK60HP only" },
    { "when": { "body": "BR" }, "forbid": { "size": ["250", "300", "400"] },
      "reason": "bronze is printed 1/4 to 2 inch" },
    { "when": { "body": "CI" }, "forbid": { "size": ["025", "038", "050", "075", "100", "125", "150", "200"] },
      "reason": "cast iron is printed 2-1/2 to 4 inch" },
    { "when": { "size": ["250", "300", "400"] }, "forbid": { "ends": ["PT", "BT", "BP", "SW", "F1", "F5", "F2", "F3"] },
      "reason": "the threaded, socket weld and FE ends belong to the 1/4 to 2 inch list; the 2-1/2 to 4 inch list is IFE only" },
    { "when": { "size": ["025", "038", "050", "075", "100", "125", "150", "200"] }, "forbid": { "ends": ["I1", "I2"] },
      "reason": "the 125# and 250# IFE codes are printed in the 2-1/2 to 4 inch list only" },
    { "when": { "body": ["DI", "BR", "CI"] }, "forbid": { "ends": ["I7", "I6", "I8", "I4"] },

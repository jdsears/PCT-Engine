  "constraints": [
    { "when": { "operation": ["HL", "EB", "NN", "M1", "M2", "M3", "M4", "M8"] }, "forbid": { "pressure": ["60", "80"] },
      "reason": "an air supply pressure applies only to a pneumatic actuator" },
    { "when": { "operation": ["P1", "P2", "P3", "P4", "P5", "S1", "S2", "S3", "S4", "S5", "S6"] }, "forbid": { "pressure": ["NN"] },

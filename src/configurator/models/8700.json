    { "when": { "solenoid": ["4A", "4B", "4D", "4E"] }, "forbid": { "operation": ["HL", "EB", "NN", "S1", "S2", "S3", "S4", "S5", "S6", "M1", "M2", "M3", "M4", "M8"] },
      "reason": "a four-way solenoid pairs with a double acting actuator, as its own table marks" },
    { "when": { "solenoid": ["3J", "3Q"] }, "forbid": { "operation": ["S5", "S6"] },
      "reason": "the 8317 solenoids cover UT-0 to UT-2.5, per their printed span" },
    { "when": { "solenoid": ["3M", "3R"] }, "forbid": { "operation": ["S1", "S2", "S3", "S4"] },
      "reason": "the 8321 solenoids cover UT-3 to UT-5, per their printed span" },
    { "when": { "solenoid": ["4A", "4D"] }, "forbid": { "operation": ["P2", "P3", "P4", "P5"] },
      "reason": "these solenoids are marked for the UT-0A actuator alone" },
    { "when": { "limitSwitch": ["AA", "AC"] }, "forbid": { "operation": ["HL", "EB", "NN", "S6", "M1", "M2", "M3", "M4", "M8"] },
      "reason": "these limit switches mount to UT-0 through UT-3 actuators, per their printed range" },
    { "when": { "limitSwitch": ["AB", "AD"] }, "forbid": { "operation": ["HL", "EB", "NN", "P1", "P2", "P3", "P4", "P5", "S1", "S2", "S3", "S4", "S5", "M1", "M2", "M3", "M4", "M8"] },
      "reason": "these limit switches mount to UT-3.5 through UT-7 actuators, per their printed range" },
    { "when": { "fail": ["01", "02"] }, "forbid": { "operation": ["HL", "EB", "NN", "P1", "P2", "P3", "P4", "P5", "M1", "M2", "M3", "M4", "M8"] },
      "reason": "a fail position is the spring's doing; it belongs to spring return builds" }

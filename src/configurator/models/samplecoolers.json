    "section": "Ordering Schematic, SC30/SC50/SC60 series"
  },
  "note": "Extracted by hand from the ordering schematic. The cooling water connection and legs sections are printed per series and enforced: the SC30 and SC50 take the 3/4 inch tri-clamp connection alone, the SC60 the full ladder; the SC30 takes the leg options, the SC50 and SC60 the 00 none row. One finish, electro-polish. The sheet's accessory pointers, sample valve, hose, outlet adapter and carrying case, live on the accessories data sheet, not in this code.",
  "assembly": "{model}-{connection}-{legs}-{finish}",
  "slots": [
    {
      "id": "model",
      "label": "Model",
      "position": 1,
      "required": true,
      "options": [
        {
          "code": "SC30",
          "label": "Sealed body portable unit with 1/2\" tri-clamp sample inlet, outlet",
          "aliases": [
            "sc30 portable"
          ]
        },
        {
          "code": "SC50",
          "label": "Tri-clamp body unit with 1/2\" tri-clamp sample inlet, outlet",
          "aliases": [
            "sc50"
          ]
        },
        {
          "code": "SC60",
          "label": "Sealed body unit with 1/2\" tri-clamp sample inlet, outlet",
          "aliases": [
            "sc60"
          ]
        }
      ]
    },
    {
      "id": "connection",

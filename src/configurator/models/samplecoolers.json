          "aliases": [
            "1/2 bsp"
          ]
        },
        {
          "code": "D",
          "label": "3/4\" tri-clamp",
          "aliases": [
            "3/4 tri-clamp"
          ]
        },
        {
          "code": "E",
          "label": "1\" tri-clamp (SC60 series)",
          "aliases": [
            "1 tri-clamp"
          ]
        }
      ]
    },

  "constraints": [
    { "when": { "size": "800" }, "forbid": { "model": ["75", "75TP"] },
      "reason": "the 8 inch is printed available with the side positioner model alone" },
    { "when": { "ends": "I5" }, "forbid": { "size": ["100", "150", "200", "250", "300", "400", "600"] },
      "reason": "the 150# bolt thru is printed 8 inch only" },
    { "when": { "ends": ["C3", "C5"] }, "forbid": { "size": ["100", "150", "200", "250", "300", "400", "800"] },
      "reason": "the bolt thru 6 inch rows are printed for the 6 inch" },
    { "when": { "ends": ["C3", "C5"] }, "forbid": { "body": ["CB", "SB"] },
      "reason": "the bolt thru 6 inch rows are printed CS and S6 only" },
    { "when": { "rangeActuator": ["A9", "B9"] }, "forbid": { "model": ["75", "75TP"] },
      "reason": "the 100M class is printed for the 8 inch side positioner alone" },
    { "when": { "rangeActuator": ["A9", "B9"] }, "forbid": { "size": ["100", "150", "200", "250", "300", "400", "600"] },
      "reason": "the 100M class is printed for the 8 inch side positioner alone" },
    { "when": { "model": "75SP" }, "forbid": { "rangeActuator": ["C3", "C5", "C8", "D3", "D5", "D8", "E3", "E5", "E8", "F3", "F5", "F8", "G3", "G5", "G8", "H3", "H5", "H8"] },
      "reason": "the side positioner table prints the direct and reverse rows alone" },
    { "when": { "model": "75", "rangeActuator": ["C3", "C5", "C8", "D3", "D5", "D8", "E3", "E5", "E8", "F3", "F5", "F8"] }, "forbid": { "smp": ["0"] },
      "reason": "the starred 3-9 and 9-15 ranges are positioner required; a plain 75 needs the SMP position filled" },
    { "when": { "rangeActuator": ["A3", "B3", "C3", "D3", "E3", "F3", "G3", "H3"] }, "forbid": { "diaphragm": ["B5", "B8", "B9"], "actuator": ["A5", "A8", "A9"] },
      "reason": "the actuator size digit runs through the range, diaphragm and actuator positions, here 35M" },
    { "when": { "rangeActuator": ["A5", "B5", "C5", "D5", "E5", "F5", "G5", "H5"] }, "forbid": { "diaphragm": ["B3", "B8", "B9"], "actuator": ["A3", "A8", "A9"] },
      "reason": "the actuator size digit runs through the range, diaphragm and actuator positions, here 55M" },
    { "when": { "rangeActuator": ["A8", "B8", "C8", "D8", "E8", "F8", "G8", "H8"] }, "forbid": { "diaphragm": ["B3", "B5", "B9"], "actuator": ["A3", "A5", "A9"] },
      "reason": "the actuator size digit runs through the range, diaphragm and actuator positions, here 85M" },
    { "when": { "rangeActuator": ["A9", "B9"] }, "forbid": { "diaphragm": ["B3", "B5", "B8"], "actuator": ["A3", "A5", "A8"] },
      "reason": "the actuator size digit runs through the range, diaphragm and actuator positions, here 100M" },
    { "when": { "accessory1": "H5" }, "forbid": { "actuator": ["A3", "A8", "A9"] },
      "reason": "the handwheel names its actuator, 55M" },
    { "when": { "accessory1": "H8" }, "forbid": { "actuator": ["A3", "A5", "A9"] },
      "reason": "the handwheel names its actuator, 85M" },
    { "when": { "accessory1": "H9" }, "forbid": { "actuator": ["A3", "A5", "A8"] },
      "reason": "the handwheel names its actuator, 100M" },
    { "when": { "accessory2": "3" }, "forbid": { "actuator": ["A5", "A8", "A9"] },

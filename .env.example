# Copy this file to .env and fill in real values. Never commit .env.

# Postgres connection string. Railway provides this for the database service.
# Use the internal connection string for the deployed service, or the public
# proxy string when running migrate or ingest from your own machine.
DATABASE_URL=

# Voyage AI key, used by the embedding step during ingestion.
VOYAGE_API_KEY=

# Anthropic key, used by the answer layer to generate grounded replies.
ANTHROPIC_API_KEY=

# Optional. Defaults to claude-sonnet-4-6. Overrides the answer model.
CLAUDE_MODEL=

# Optional. Defaults to voyage-3.5. Set to voyage-3-large for top-end quality.
VOYAGE_MODEL=

# Set in the deployed environment.
NODE_ENV=production

# Shared access key for the pilot gate. When set, /ask, /search and /api require
# it; the static app shell stays public. Leave blank to run with the gate open,
# for local work. Generate a strong value, for example: openssl rand -base64 32
APP_ACCESS_KEY=

# Microsoft Graph, app-only. The tenant, client id, SharePoint host and site,
# and the engine mailbox are configuration, not secrets. The client secret is
# the only sensitive value here. Supply it locally and in Railway, never commit it.
MS_TENANT_ID=a80728ef-95ec-49e9-a733-7d0924a2ffb7
MS_CLIENT_ID=4b397bff-e86b-4ba7-b897-947cf3a09017
MS_CLIENT_SECRET=
SP_HOSTNAME=pctflow.sharepoint.com
SP_SITE_PATH=/sites/SalesEngine
ENGINE_MAILBOX=salesengine@pctflow.com

# Teams bot for the Co-Pilot in personal chat. A separate app registration from
# the Graph app above, so the bot's reach stays its own. The app id is not a
# secret; the password is. Both come from registering the bot, and the password
# goes in Railway and .env only. The bot is single tenant, so it uses
# MS_TENANT_ID above. The endpoint stays inert until both are set.
TEAMS_BOT_APP_ID=
TEAMS_BOT_APP_PASSWORD=

# Mail send is gated. Leave on until the constraint policy is in place. This is
# the production gate: while it is on, no email goes to a real prospect.
MAIL_KILL_SWITCH=on

# Internal test sends for the outbound testing window. These let an approved
# draft be sent to internal mailboxes only, never a prospect, and are governed
# independently of MAIL_KILL_SWITCH so sending can be exercised while production
# stays off. Turn on and list the allowed internal addresses, comma separated; an
# address not on the list is refused. Leave off and blank to disable test sends.
OUTBOUND_TEST_SENDS=off
OUTBOUND_TEST_RECIPIENTS=

# Testing window only. When on, the reply poller also matches replies to
# internal test sends, so the replied stage can be demonstrated end to end
# without a prospect. Leave off in normal running, so only real sends match.
REPLY_CAPTURE_TEST_SENDS=off

# Research stage. Companies House is a free key from
# developer.company-information.service.gov.uk; Tavily and Findymail are the
# existing MoonBoots keys. All three are secrets, never commit them.
COMPANIES_HOUSE_API_KEY=
TAVILY_API_KEY=
FINDYMAIL_API_KEY=

# Optional. Minimum ICP score for a company to become a lead. Defaults to 40.
RESEARCH_LEAD_THRESHOLD=

# How often the in-service signal engine runs when switched on from the Health
# page. Hours, defaults to 6. The switch itself lives in the database (kv), so
# turning the engine on and off never needs a redeploy. The deployed service
# needs the research keys above for the runs to find anything.
ENGINE_RUN_INTERVAL_HOURS=

# Unipile, for the LinkedIn research lane. The DSN is the per-account API host
# Unipile assigns, for example https://api8.unipile.com:13851; the key is a
# secret. Run scripts/unipile-check.mjs to verify and resolve the account id,
# then set it here and in Railway. The lane is read-only research, hard capped
# at LINKEDIN_DAILY_CAP Unipile calls per UTC day.
UNIPILE_DSN=
UNIPILE_API_KEY=
UNIPILE_ACCOUNT_ID=
LINKEDIN_DAILY_CAP=40

# Country to keep in the people search, since the decision-makers are on UK
# builds. Defaults to uk, which drops results that name another country and
# keeps UK and unstated ones. Set to any other value to disable the filter.
LINKEDIN_COUNTRY=uk

# Findymail email discovery inside the LinkedIn enrich run. Stays off until
# Andy's curated account list is applied, so no credits are spent on accounts
# he is about to strike.
EMAIL_DISCOVERY=off

# Draft ICP contactability component, staged for James and Andy. Off until
# they approve the rebalanced weights; on, accounts earn up to 10 points for
# a decision-orbit contact and a verified email, and re-score on the next run.
ICP_CONTACTABILITY=off

{
  "$schema": "https://developer.microsoft.com/en-us/json-schemas/teams/v1.19/MicrosoftTeams.schema.json",
  "manifestVersion": "1.19",
  "version": "1.0.0",
  "id": "__BOT_APP_ID__",
  "developer": {
    "name": "MoonBoots Consultancy",
    "websiteUrl": "https://moonbootscapital.io",
    "privacyUrl": "https://moonbootscapital.io/privacy",
    "termsOfUseUrl": "https://moonbootscapital.io/terms"
  },
  "name": {
    "short": "PCT Co-Pilot",
    "full": "PCT Knowledge Co-Pilot"
  },
  "description": {
    "short": "Ask the PCT knowledge base. Answers cite their sources.",
    "full": "The PCT Knowledge Co-Pilot answers questions from the PCT and Richards product documentation in a one to one chat, and cites the documents each answer draws on. Built for the PCT sales team."
  },
  "icons": {
    "color": "color.png",
    "outline": "outline.png"
  },
  "accentColor": "#1F386B",
  "bots": [
    {
      "botId": "__BOT_APP_ID__",
      "scopes": ["personal"],
      "supportsFiles": false,
      "isNotificationOnly": false
    }
  ],
  "validDomains": []
}
